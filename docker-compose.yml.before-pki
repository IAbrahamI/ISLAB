services:
  npmplus:
    image: docker.io/zoeyvid/npmplus:latest
    container_name: npmplus
    restart: unless-stopped
    ports:
      - "80:80"        # HTTP
      - "443:443"      # HTTPS
      - "443:443/udp"  # HTTP/3 (QUIC)
      - "81:81"        # Admin UI
    volumes:
      - ./npmplus-data:/data
    environment:
      - TZ=Europe/Zurich            # change to your timezone
      - ACME_EMAIL=${ACME_EMAIL}  # used for Let's Encrypt
