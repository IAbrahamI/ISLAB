# Copy to .env and fill in. .env is not committed.
ACME_EMAIL=you@example.com
TZ=Europe/Zurich
# Address NPMplus and dnsmasq listen on:
#  - before WireGuard runs: the server's LAN IP (e.g. 192.168.1.10)
#  - after WireGuard runs:  the WireGuard address (e.g. 10.8.0.1)
# Never 0.0.0.0: port 53 would clash with the system resolver and everything would be exposed.
BIND_IP=10.8.0.1
